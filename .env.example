# Copie este arquivo para .env e preencha os valores. O .env não vai para o git.
# Em produção, defina as mesmas variáveis no ambiente (sem arquivo).

# Banco PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/pack-db
DB_USERNAME=postgres
DB_PASSWORD=troque-aqui

# Chave que assina os tokens JWT: pelo menos 32 caracteres aleatórios.
# Para gerar uma no PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais

# Admin criado na primeira vez que a aplicação sobe
ADMIN_EMAIL=admin@packapi.com
ADMIN_PASSWORD=troque-aqui
