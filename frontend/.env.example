# Modelo da configuração do frontend. Nenhum valor aqui é segredo: são só o modo e o endereço da API.
#
# Os modos já vêm prontos e vão para o git. O Vite escolhe o arquivo sozinho, pelo comando:
#
#   comando            arquivo lido        VITE_USAR_API   PACK_API_URL
#   npm run dev        .env.development    true            http://localhost:8080  (API local, em backend/)
#   npm run dev:demo   .env.demo           false           (não usa)              (dados de src/data)
#   npm run build      .env.production     true            https://pack-api-….run.app  (API no Cloud Run)
#
# Cada modo tem o seu arquivo porque o Vite só lê o do modo em uso. Um .env único valeria para
# todos os modos ao mesmo tempo, e o dev e o build passariam a usar a mesma API.
#
# Para mudar algo SÓ na sua máquina, sem mexer nos arquivos do git, copie este modelo para o
# arquivo .local do modo (fica fora do git e vale mais que o arquivo do modo):
#   cp .env.example .env.development.local     (npm run dev)
#   cp .env.example .env.demo.local            (npm run dev:demo)
#   cp .env.example .env.production.local      (npm run build)
# e deixe nele só as linhas que quer trocar.


# "true" usa a Pack API; "false", os dados de demonstração (src/data).
# Começa com VITE_ porque o navegador também precisa saber o modo.
VITE_USAR_API=true

# Endereço da Pack API, sem barra no fim. Só o servidor do frontend o lê (sem VITE_, nunca vai
# para o navegador). Exemplos:
#   API local (docker compose ou ./mvnw, em backend/):   http://localhost:8080
#   API em produção (Cloud Run):                         https://pack-api-872578691493.southamerica-east1.run.app
# Em produção, a variável de ambiente PACK_API_URL da hospedagem vale mais que o arquivo.
PACK_API_URL=http://localhost:8080
