# Modo de desenvolvimento (npm run dev): a Pack API local, do docker compose.
# Não tem segredo: é só o endereço. Para mudar só na sua máquina, use .env.development.local.
VITE_USAR_API=true
PACK_API_URL=http://localhost:8080
# Chave do IP do visitante só do desenvolvimento local (a mesma do backend/docker-compose.yml).
# Em produção, a chave fica no Secret Manager e na variável PACK_BFF_CHAVE da hospedagem.
PACK_BFF_CHAVE=desenvolvimento-local-sem-segredo
